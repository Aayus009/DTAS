<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="DigitalTransparencySystem.SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" class="scroll-smooth" lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">DTAS Portal</asp:ContentPlaceHolder></title>
    <link rel="icon" type="image/svg+xml" href="/Assets/img/dtas-logo.svg?v=3" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="description" content="Digital Transparency and Accountability Status System for Educational Community Decision Making" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,700;1,800&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <!-- Tailwind CDN with Custom Config -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "pacific-blue": "#0077b6",
                        "slate-deep": "#023e8a",
                        "surface-gray": "#f1f5f9",
                        "border-light": "#e2e8f0",

                        "tertiary": "rgb(var(--dt-tertiary-rgb) / <alpha-value>)",
                        "on-tertiary": "rgb(var(--dt-on-tertiary-rgb) / <alpha-value>)",
                        "tertiary-container": "rgb(var(--dt-tertiary-container-rgb) / <alpha-value>)",
                        "on-tertiary-container": "rgb(var(--dt-on-tertiary-container-rgb) / <alpha-value>)",
                        "tertiary-fixed": "rgb(var(--dt-tertiary-fixed-rgb) / <alpha-value>)",
                        "on-tertiary-fixed": "rgb(var(--dt-on-tertiary-fixed-rgb) / <alpha-value>)",
                        "tertiary-fixed-dim": "rgb(var(--dt-tertiary-fixed-dim-rgb) / <alpha-value>)",
                        "on-tertiary-fixed-variant": "rgb(var(--dt-on-tertiary-fixed-variant-rgb) / <alpha-value>)",

                        "secondary": "rgb(var(--dt-secondary-rgb) / <alpha-value>)",
                        "on-secondary": "rgb(var(--dt-on-secondary-rgb) / <alpha-value>)",
                        "secondary-container": "rgb(var(--dt-secondary-container-rgb) / <alpha-value>)",
                        "on-secondary-container": "rgb(var(--dt-on-secondary-container-rgb) / <alpha-value>)",
                        "secondary-fixed": "rgb(var(--dt-secondary-fixed-rgb) / <alpha-value>)",
                        "on-secondary-fixed": "rgb(var(--dt-on-secondary-fixed-rgb) / <alpha-value>)",
                        "secondary-fixed-dim": "rgb(var(--dt-secondary-fixed-dim-rgb) / <alpha-value>)",
                        "on-secondary-fixed-variant": "rgb(var(--dt-on-secondary-fixed-variant-rgb) / <alpha-value>)",

                        "primary": "rgb(var(--dt-primary-rgb) / <alpha-value>)",
                        "on-primary": "rgb(var(--dt-on-primary-rgb) / <alpha-value>)",
                        "primary-container": "rgb(var(--dt-primary-container-rgb) / <alpha-value>)",
                        "on-primary-container": "rgb(var(--dt-on-primary-container-rgb) / <alpha-value>)",
                        "primary-fixed": "rgb(var(--dt-primary-fixed-rgb) / <alpha-value>)",
                        "on-primary-fixed": "rgb(var(--dt-on-primary-fixed-rgb) / <alpha-value>)",
                        "primary-fixed-dim": "rgb(var(--dt-primary-fixed-dim-rgb) / <alpha-value>)",
                        "on-primary-fixed-variant": "rgb(var(--dt-on-primary-fixed-variant-rgb) / <alpha-value>)",
                        "inverse-primary": "rgb(var(--dt-inverse-primary-rgb) / <alpha-value>)",

                        "background": "rgb(var(--dt-background-rgb) / <alpha-value>)",
                        "on-background": "rgb(var(--dt-on-background-rgb) / <alpha-value>)",
                        "surface": "rgb(var(--dt-surface-rgb) / <alpha-value>)",
                        "on-surface": "rgb(var(--dt-on-surface-rgb) / <alpha-value>)",
                        "surface-variant": "rgb(var(--dt-surface-variant-rgb) / <alpha-value>)",
                        "on-surface-variant": "rgb(var(--dt-on-surface-variant-rgb) / <alpha-value>)",
                        "inverse-surface": "rgb(var(--dt-inverse-surface-rgb) / <alpha-value>)",
                        "inverse-on-surface": "rgb(var(--dt-inverse-on-surface-rgb) / <alpha-value>)",
                        "surface-tint": "rgb(var(--dt-surface-tint-rgb) / <alpha-value>)",
                        "surface-dim": "rgb(var(--dt-surface-dim-rgb) / <alpha-value>)",
                        "surface-bright": "rgb(var(--dt-surface-bright-rgb) / <alpha-value>)",
                        "surface-container-lowest": "rgb(var(--dt-surface-container-lowest-rgb) / <alpha-value>)",
                        "surface-container-low": "rgb(var(--dt-surface-container-low-rgb) / <alpha-value>)",
                        "surface-container": "rgb(var(--dt-surface-container-rgb) / <alpha-value>)",
                        "surface-container-high": "rgb(var(--dt-surface-container-high-rgb) / <alpha-value>)",
                        "surface-container-highest": "rgb(var(--dt-surface-container-highest-rgb) / <alpha-value>)",

                        "outline": "rgb(var(--dt-outline-rgb) / <alpha-value>)",
                        "outline-variant": "rgb(var(--dt-outline-variant-rgb) / <alpha-value>)",

                        "error": "rgb(var(--dt-error-rgb) / <alpha-value>)",
                        "on-error": "rgb(var(--dt-on-error-rgb) / <alpha-value>)",
                        "error-container": "rgb(var(--dt-error-container-rgb) / <alpha-value>)",
                        "on-error-container": "rgb(var(--dt-on-error-container-rgb) / <alpha-value>)",
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "2xl": "0.75rem",
                        "3xl": "1rem",
                        "full": "9999px"
                    },
                    spacing: {
                        "gutter": "24px",
                        "container-padding-mobile": "20px",
                        "base": "8px",
                        "container-padding-desktop": "64px",
                        "section-gap": "48px"
                    },
                    maxWidth: {
                        "7xl": "1400px"
                    },
                    backgroundImage: {
                        "gradient-colorful": "linear-gradient(135deg, #023e8a 0%, #0077b6 40%, #48cae4 75%, #90e0ef 100%)",
                        "gradient-hero": "linear-gradient(135deg, #001d32 0%, #023e8a 55%, #0077b6 100%)",
                    },
                    fontFamily: {
                        "badge-cap": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "display-lg": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "title-lg": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "body-lg": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "headline-lg": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "headline-lg-mobile": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "label-md": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "label-sm": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "label-lg": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "body-md": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"],
                        "headline-md": ["\"Hanken Grotesk\"", "ui-sans-serif", "system-ui", "sans-serif"]
                    },
                    fontSize: {
                        "badge-cap": ["11px", { lineHeight: "16px", letterSpacing: "0.05em", fontWeight: "700" }],
                        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "800" }],
                        "display-lg-mobile": ["36px", { lineHeight: "44px", letterSpacing: "-0.01em", fontWeight: "800" }],
                        "title-lg": ["20px", { lineHeight: "28px", fontWeight: "700" }],
                        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
                        "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "700" }],
                        "headline-lg-mobile": ["28px", { lineHeight: "36px", fontWeight: "700" }],
                        "label-md": ["14px", { lineHeight: "20px", fontWeight: "600" }],
                        "label-sm": ["12px", { lineHeight: "16px", letterSpacing: "0.05em", fontWeight: "700" }],
                        "label-lg": ["14px", { lineHeight: "20px", fontWeight: "600" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "headline-md": ["24px", { lineHeight: "32px", letterSpacing: "-0.01em", fontWeight: "600" }]
                    }
                }
            }
        }
    </script>
    
    <!-- Shared Styles -->
    <link rel="stylesheet" type="text/css" href="/Assets/css/style.css?v=navfix2" />
    <link rel="stylesheet" type="text/css" href="/Assets/css/dashboard.css?v=navfix2" />
    <link rel="stylesheet" type="text/css" href="/Assets/css/animations.css?v=7" />
    <link rel="stylesheet" type="text/css" href="/Assets/css/public-chrome.css?v=7" />
    <link rel="stylesheet" type="text/css" href="/Assets/css/modal.css?v=5" />
    <style>
        .auth-modal-content { width: min(460px, calc(100vw - 2.5rem)) !important; background: transparent !important; box-shadow: none !important; overflow: hidden !important; }
        .auth-modal-content.is-register { width: min(520px, calc(100vw - 2.5rem)) !important; }
        .auth-modal-iframe { background: transparent !important; overflow: hidden !important; }
        .auth-modal-close { display: none !important; }
    </style>
    
    <!-- Page-specific styles -->
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>

    <!-- Theme init: apply saved/system theme before paint to avoid flash -->
    <script type="text/javascript">
        (function () {
            var path = (location.pathname || '/').toLowerCase();
            var isPublic = path === '/' || path === ''
                || /\/(default|features|about|faq|contact|demo)\.aspx$/i.test(path);
            if (isPublic) {
                document.documentElement.classList.remove('dark');
                return;
            }
            var theme = null;
            try {
                theme = localStorage.getItem('dtas-theme');
            } catch (e) { }
            if (!theme || theme === 'system') {
                theme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
            }
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>
<body class="bg-surface text-on-surface font-body-md selection:bg-primary-fixed selection:text-on-primary-fixed">
    <form id="form1" runat="server">
        
        <!-- ==================== HEADER / NAVBAR (Decidim-style) ==================== -->
        <asp:Panel ID="pnlPublicNavbar" runat="server">
        <header class="pub-header">
            <div class="pub-header-inner">
                <a href="/Default.aspx" class="pub-brand" aria-label="DTAS - Home">
                    <span class="dtas-wordmark dtas-wordmark-light">DTAS</span>
                </a>
                <nav class="pub-nav">
                    <a href="/Default.aspx" id="navHome">Home</a>
                    <a href="/Features.aspx" id="navFeatures">Features</a>
                    <a href="/Transparency.aspx" id="navTransparency" onclick="requireAuth('/Transparency.aspx'); return false;">Transparency</a>
                    <a href="/About.aspx" id="navAbout">About</a>
                    <a href="/FAQ.aspx" id="navFAQ">FAQ</a>
                    <a href="/Contact.aspx" id="navContact">Contact</a>
                </nav>
                <div class="pub-actions">
                    <a href="javascript:void(0)" onclick="openLogin()" class="pub-link">Sign in</a>
                    <a href="javascript:void(0)" onclick="openRegister()" class="pub-register">Register</a>
                    <button type="button" class="pub-menu-btn nav-toggle" id="navToggle" aria-label="Toggle navigation">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                </div>
            </div>
            <div class="pub-mobile hidden" id="mobileMenu">
                <a href="/Default.aspx">Home</a>
                <a href="/Features.aspx">Features</a>
                <a href="/Transparency.aspx" onclick="requireAuth('/Transparency.aspx'); return false;">Transparency</a>
                <a href="/About.aspx">About</a>
                <a href="/FAQ.aspx">FAQ</a>
                <a href="/Contact.aspx">Contact</a>
                <a href="javascript:void(0)" onclick="openLogin()">Sign in</a>
                <a href="javascript:void(0)" onclick="openRegister()">Register</a>
            </div>
        </header>
        </asp:Panel>
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- ==================== FOOTER ==================== -->
        <asp:Panel ID="pnlPublicFooter" runat="server">
        <footer class="pub-footer">
            <div class="pub-footer-grid">
                <div>
                    <a href="/Default.aspx" class="pub-footer-brand" aria-label="DTAS - Home">
                        <span class="dtas-wordmark dtas-wordmark-light">DTAS</span>
                    </a>
                    <p>A campus record for proposals, meetings, decisions, and follow-through that students and faculty can actually follow.</p>
                </div>
                <div>
                    <h4>Platform</h4>
                    <nav>
                        <a href="/Transparency.aspx" onclick="requireAuth('/Transparency.aspx'); return false;">Transparency</a>
                        <a href="/Features.aspx">Features</a>
                        <a href="/FAQ.aspx">How DTAS works</a>
                    </nav>
                </div>
                <div>
                    <h4>Resources</h4>
                    <nav>
                        <a href="/FAQ.aspx">FAQ</a>
                        <a href="/About.aspx">About</a>
                        <a href="/Contact.aspx">Privacy &amp; contact</a>
                    </nav>
                </div>
                <div>
                    <h4>Support</h4>
                    <nav>
                        <a href="/Contact.aspx">Contact support</a>
                        <a href="/FAQ.aspx">Security FAQ</a>
                        <a href="/Contact.aspx">Cookies &amp; support</a>
                    </nav>
                </div>
            </div>
            <div class="pub-footer-base">
                <span>&copy; 2026 DTAS. All rights reserved.</span>
                <div class="pub-footer-icons">
                    <a href="/About.aspx" aria-label="About">About</a>
                    <a href="/Contact.aspx" aria-label="Contact">Contact</a>
                </div>
            </div>
        </footer>
        </asp:Panel>

        <!-- ==================== AUTH MODAL ==================== -->
        <div id="authModal" class="auth-modal-overlay" onclick="if(event.target===this)closeAuthModal()">
            <div class="auth-modal-content">
                <button type="button" class="auth-modal-close" onclick="closeAuthModal()" aria-label="Close">&times;</button>
                <iframe id="authModalFrame" class="auth-modal-iframe" src="about:blank" allowtransparency="true" scrolling="no"></iframe>
            </div>
        </div>

    </form>

    <!-- Shared Scripts -->
    <script type="text/javascript" src='<%: ResolveUrl("~/Assets/js/main.js") %>'></script>
    <script type="text/javascript" src='<%: ResolveUrl("~/Assets/js/dashboard.js") %>'></script>
    <script type="text/javascript" src='<%: ResolveUrl("~/Assets/js/dtas-dialog.js") %>'></script>
    <link rel="prefetch" href="/LoginPopup.aspx?embed=1" />
    <link rel="prefetch" href="/RegisterPopup.aspx?embed=1" />
    <script type="text/javascript">
        function fitAuthFrameFromDoc() {
            var frame = document.querySelector('.auth-modal-iframe');
            if (!frame) return;
            try {
                var doc = frame.contentDocument;
                if (!doc) return;
                var card = doc.querySelector('.auth-card');
                if (!card) return;
                var h = Math.ceil(card.getBoundingClientRect().height);
                if (h < 80) return;
                var maxH = Math.floor(window.innerHeight * 0.96);
                frame.style.setProperty('height', Math.min(h, maxH) + 'px', 'important');
            } catch (err) {}
        }
        function fitAuthFrame(height) {
            var frame = document.querySelector('.auth-modal-iframe');
            if (!frame || !height) return;
            var maxH = Math.floor(window.innerHeight * 0.96);
            frame.style.setProperty('height', Math.min(Math.ceil(height), maxH) + 'px', 'important');
        }
        function openAuthFrame(url, isRegister) {
            var modal = document.querySelector('.auth-modal-overlay');
            var box = document.querySelector('.auth-modal-content');
            var frame = document.querySelector('.auth-modal-iframe');
            if (!modal || !frame) return;
            if (box) box.classList.toggle('is-register', !!isRegister);
            frame.classList.toggle('is-register', !!isRegister);
            if (frame.getAttribute('data-src') !== url) {
                frame.style.removeProperty('height');
                frame.setAttribute('data-src', url);
                frame.src = url;
            } else if (frame.contentWindow) {
                try { frame.contentWindow.postMessage({ type: 'auth-measure' }, '*'); } catch (err) {}
            }
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
            setTimeout(fitAuthFrameFromDoc, 30);
            setTimeout(fitAuthFrameFromDoc, 120);
        }
        var currentAuthNext = '';
        function sanitizeAuthNext(next) {
            if (!next || typeof next !== 'string') return '';
            next = next.replace(/^\s+|\s+$/g, '');
            if (next.charAt(0) !== '/' || next.indexOf('//') === 0) return '';
            return next;
        }
        function authNextQuery(next) {
            next = sanitizeAuthNext(next);
            return next ? '&next=' + encodeURIComponent(next) : '';
        }
        function openLogin(next) {
            if (arguments.length > 0) currentAuthNext = sanitizeAuthNext(next);
            openAuthFrame('/LoginPopup.aspx?embed=1' + authNextQuery(currentAuthNext), false);
        }
        function openRegister(next) {
            if (arguments.length > 0) currentAuthNext = sanitizeAuthNext(next);
            openAuthFrame('/RegisterPopup.aspx?embed=1' + authNextQuery(currentAuthNext), true);
        }
        function requireAuth(next) {
            openLogin(sanitizeAuthNext(next) || '/Transparency.aspx');
        }
        function closeAuthModal() {
            var modal = document.querySelector('.auth-modal-overlay');
            if (modal) modal.classList.remove('active');
            document.body.style.overflow = '';
            currentAuthNext = '';
        }
        window.addEventListener('message', function (e) {
            if (!e.data) return;
            if (e.data.type === 'auth-redirect') window.location.href = e.data.url;
            if ((e.data.type === 'auth-ready' || e.data.type === 'auth-resize') && e.data.height)
                fitAuthFrame(e.data.height);
        });
        (function () {
            try {
                var params = new URLSearchParams(window.location.search);
                var next = params.get('next');
                var extras = '';
                if (params.get('google')) extras += '&google=' + encodeURIComponent(params.get('google'));
                if (params.get('reason')) extras += '&reason=' + encodeURIComponent(params.get('reason'));
                if (params.get('signin') === '1') {
                    currentAuthNext = sanitizeAuthNext(next) || '';
                    openAuthFrame('/LoginPopup.aspx?embed=1' + authNextQuery(currentAuthNext) + extras, false);
                } else if (params.get('signup') === '1') {
                    openRegister(next);
                }
                if ((params.get('signin') === '1' || params.get('signup') === '1') && window.history && history.replaceState)
                    history.replaceState({}, document.title, window.location.pathname + window.location.hash);
            } catch (err) {}
            var frame = document.querySelector('.auth-modal-iframe');
            if (frame) {
                frame.addEventListener('load', function () {
                    fitAuthFrameFromDoc();
                    setTimeout(fitAuthFrameFromDoc, 80);
                });
            }
            window.addEventListener('load', function () {
                if (!frame || frame.getAttribute('data-src')) return;
                if (!document.querySelector('a[onclick="openLogin()"]')) return;
                frame.setAttribute('data-src', '/LoginPopup.aspx?embed=1');
                frame.src = '/LoginPopup.aspx?embed=1';
            });
        })();
    </script>
    
    <!-- Page-specific scripts -->
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>