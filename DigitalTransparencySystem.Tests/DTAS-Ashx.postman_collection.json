{
  "info": {
    "name": "DTAS JSON handlers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:44353" }
  ],
  "item": [
    {
      "name": "API-01 ConnectApi no session",
      "request": {
        "method": "GET",
        "header": [],
