<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DigitalTransparencySystem.Tests</RootNamespace>
    <AssemblyName>DigitalTransparencySystem.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="DigitalTransparencySystem">
      <HintPath>..\DigitalTransparencySystem\bin\DigitalTransparencySystem.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\DigitalTransparencySystem\bin\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyConfigForTestHost" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)DigitalTransparencySystem.Tests.dll.config"
          DestinationFiles="$(OutputPath)testhost.dll.config"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)DigitalTransparencySystem.Tests.dll.config')" />
    <Copy SourceFiles="$(OutputPath)DigitalTransparencySystem.Tests.dll.config"
          DestinationFiles="$(OutputPath)testhost.exe.config"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)DigitalTransparencySystem.Tests.dll.config')" />
  </Target>
</Project>
